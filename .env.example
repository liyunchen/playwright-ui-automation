# ============================================================================
# 凭证模板文件
#   1. cp .env.example .env
#   2. 填入真实值（.env 已在 .gitignore 中，不会提交）
#   3. config/env_config.yaml 通过 ${VAR} 引用这里的键
#
# 安全约定：真实口令只进 .env 或 CI 凭证中心，严禁写入本文件或任何入库文件。
# ============================================================================

# ---- 平台登录口令（被测QA 自动化测试平台）----
# 对应 config/env_config.yaml 中 username/password 字段的 ${VAR} 占位符
qa_password=your_password_here

# ---- 错误口令用例专用 ----
# test_login_with_wrong_password_shows_error 故意用错口令登录，验证返回 401。
# 值本身无意义，但从环境变量取可避免把测试数据写死在代码里。
# QA_WRONG_PASSWORD=wrong_password_for_test

# ---- 可选：覆盖被测平台地址 / 账号 / 项目代码 ----
# 不填则取 config/env_config.yaml 中 qa 环境的默认值（已替换为示例域名）
# 内部使用时在这里填真实地址即可，无需改代码或配置文件
# QA_URL=https://qa-platform.example.com
# QA_USERNAME=your_account
# QA_PROJECT_CODE=qa_demo

# ---- 运行期开关（一般无需修改）----
# 设置后开启浏览器录像，产出 webm 到该目录（用于演示与问题复现）
# VIDEO_DIR=demo_videos
# 无头模式运行（CI 默认 true）
# HEADLESS=true
# 用例结束后保留浏览器，便于人工查看
# KEEP_BROWSER=false

# ---- 飞书机器人 Webhook（多个用英文逗号分隔）----
# CI 通知用，留空则跳过通知
FEISHU_WEBHOOK_URLS=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token-1

# ---- CI 报告上传（可选，未配置则跳过上传）----
# OBS_AK=your-access-key
# OBS_SK=your-secret-key
# OBS_BUCKET=your-bucket-name
# OBS_ENDPOINT=obs.cn-south-1.myhuaweicloud.com
# ALLURE_BASE_URL=https://your-jenkins-host/job/